# Production PostgreSQL URL, for example:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite:///./database/fun_chemistry.db

# Never put real secrets into Git.
SECRET_KEY=change-this-in-production

# Local development storage only. For production use durable object storage.
LOCAL_UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100

# Optional object-storage variables for a production adapter:
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
